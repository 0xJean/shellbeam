# Apple Development Team ID (required for iOS builds)
# Find yours at: https://developer.apple.com/account → Membership Details
IOS_DEVELOPMENT_TEAM=YOUR_TEAM_ID

# macOS notarization (required for npm run build:macos)
# Generate app-specific password at: https://appleid.apple.com → Sign-In and Security → App-Specific Passwords
APPLE_ID=your-apple-id@example.com
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=YOUR_TEAM_ID
# Android signing (required for npm run build:android signed APK)
# Generate keystore: keytool -genkey -v -keystore shellbeam.jks -keyalg RSA -keysize 2048 -validity 10000 -alias shellbeam
ANDROID_KEYSTORE_PATH=./shellbeam.jks
ANDROID_KEYSTORE_PASS=your_password
ANDROID_KEY_ALIAS=shellbeam
ANDROID_KEY_PASS=your_password
